.page { min-height: 100vh; background: linear-gradient(to bottom, #eef2ff, #ffffff); padding-bottom: 40rpx; }

.header {
  padding: 36rpx 36rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.title { font-size: 48rpx; font-weight: 900; color: #1e293b; }
.subtitle { font-size: 26rpx; color: #94a3b8; margin-top: 4rpx; }
.points {
  background: #fef3c7;
  color: #b45309;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.main { padding: 0 28rpx; max-width: 750rpx; margin: 0 auto; }
.grade { margin-bottom: 40rpx; }
.grade-title { font-weight: 700; color: #475569; margin-bottom: 16rpx; font-size: 30rpx; }
.soon {
  font-size: 22rpx;
  font-weight: 400;
  color: #94a3b8;
  background: #f1f5f9;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
}

.unit-card { background: #fff; border-radius: 28rpx; overflow: hidden; margin-bottom: 20rpx; box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.04); }
.unit-title { padding: 18rpx 28rpx; background: #f8fafc; font-size: 26rpx; font-weight: 700; color: #64748b; }
.empty { padding: 24rpx 28rpx; font-size: 26rpx; color: #cbd5e1; }
.empty-card { background: rgba(255,255,255,0.6); border-radius: 28rpx; padding: 48rpx; text-align: center; color: #cbd5e1; font-size: 26rpx; }

.skill-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
}
.skill-row-hover { background: #eef2ff; }
.skill-name { font-weight: 700; color: #1e293b; font-size: 32rpx; }
.skill-meta { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; }
.chevron { margin-left: auto; color: #cbd5e1; font-size: 40rpx; font-weight: 300; }
