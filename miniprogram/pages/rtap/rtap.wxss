/* 极速点击：深色底 + 全屏变色舞台，复刻网页版 ReactionTap */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #0f172a;
  color: #fff;
}
.header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
}
.back {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  color: #fff;
}
.title { font-size: 18px; font-weight: 700; }
.balance { margin-left: auto; font-size: 14px; opacity: 0.8; }

.main {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24px;
  padding: 0 24px 32px;
}
.desc { color: rgba(255, 255, 255, 0.8); font-size: 14px; text-align: center; max-width: 320px; }

/* 选关 */
.lv-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  width: 100%;
  max-width: 384px;
}
.lv-card {
  width: calc((100% - 12px) / 2);
  box-sizing: border-box;
  border-radius: 16px;
  padding: 16px;
  background: rgba(255, 255, 255, 0.12);
  position: relative;
  transition: transform 0.1s;
}
.lv-active { background: #fff; }
.lv-active .lv-title { color: #059669; }
.lv-active .lv-hint { color: #34d399; }
.lv-locked { opacity: 0.4; }
.lv-title { font-weight: 900; font-size: 16px; color: #fff; }
.lv-hint { font-size: 12px; color: rgba(255, 255, 255, 0.6); margin-top: 4px; }
.lv-grade {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-size: 14px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.grade-S { background: #fbbf24; color: #78350f; }
.grade-A { background: #a78bfa; color: #fff; }
.grade-B { background: #38bdf8; color: #fff; }
.grade-C { background: #34d399; color: #fff; }
.grade-D { background: #cbd5e1; color: #475569; }
.grade-E { background: #e2e8f0; color: #64748b; }
.grade-F { background: #fecaca; color: #ef4444; }

.start-btn {
  height: 64px;
  padding: 0 40px;
  border-radius: 16px;
  background: #fff;
  color: #059669;
  font-size: 20px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.1s;
}
.start-btn:active { transform: scale(0.95); }
.start-disabled { opacity: 0.4; }
.rule-hint { font-size: 12px; color: rgba(255, 255, 255, 0.5); }

/* 全屏舞台 */
.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16px;
  transition: background 0.08s;
}
.stage-wait { background: #dc2626; }
.stage-fake { background: #facc15; }
.stage-fake .stage-text, .stage-fake .stage-round, .stage-fake .stage-sub { color: #713f12; }
.stage-go { background: #16a34a; }
.stage-roundDone { background: #0f172a; }
.stage-round { font-size: 15px; font-weight: 700; opacity: 0.85; }
.stage-text { font-size: 64px; font-weight: 900; }
.stage-sub { font-size: 16px; font-weight: 700; }
.stage-done {
  position: absolute;
  bottom: 32px;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.6);
}

/* 结算 */
.big-grade {
  width: 112px;
  height: 112px;
  border-radius: 50%;
  font-size: 56px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.over-title { font-size: 24px; font-weight: 900; }
.over-sub { color: rgba(255, 255, 255, 0.8); font-size: 15px; }
.over-reward { color: #fcd34d; font-weight: 900; }
.over-detail { color: rgba(255, 255, 255, 0.5); font-size: 14px; }
.over-btns { display: flex; gap: 12px; }
.btn-white {
  height: 56px;
  padding: 0 32px;
  border-radius: 16px;
  background: #fff;
  color: #059669;
  font-weight: 900;
  display: flex;
  align-items: center;
}
.btn-ghost {
  height: 56px;
  padding: 0 32px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.15);
  font-weight: 700;
  display: flex;
  align-items: center;
}
