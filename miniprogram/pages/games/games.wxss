/* 游戏厅：紫罗兰主题，与网页版 GamesHall 一致 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 20px 16px 32px;
  background: linear-gradient(180deg, #f5f3ff 0%, #ffffff 100%);
}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px;
}
.title { font-size: 24px; font-weight: 900; color: #1e293b; }
.points {
  background: #fef3c7;
  color: #b45309;
  padding: 6px 16px;
  border-radius: 999px;
  font-size: 18px;
  font-weight: 900;
}
.tip { font-size: 13px; color: #94a3b8; margin: 8px 4px 16px; }

.card {
  background: #fff;
  border-radius: 24px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
  overflow: hidden;
  margin-bottom: 16px;
}
.card-main { padding: 20px; }
.card-hover { background: #faf5ff; }
.card-head { display: flex; align-items: center; gap: 12px; }
.card-icon { font-size: 36px; }
.card-head-text { flex: 1; }
.card-title-row { display: flex; align-items: center; gap: 8px; }
.card-title { font-size: 18px; font-weight: 700; color: #1e293b; }
.ability {
  font-size: 11px;
  font-weight: 700;
  background: #ede9fe;
  color: #7c3aed;
  padding: 2px 8px;
  border-radius: 999px;
}
.card-desc { font-size: 13px; color: #94a3b8; margin-top: 4px; }

.fee {
  margin-top: 12px;
  text-align: center;
  padding: 10px 0;
  border-radius: 12px;
  font-weight: 700;
  font-size: 15px;
}
.fee-ok { background: #7c3aed; color: #fff; }
.fee-no { background: #f1f5f9; color: #94a3b8; }

.dots { margin-top: 12px; display: flex; align-items: center; gap: 6px; }
.dot {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  font-size: 12px;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dot-open { background: #ede9fe; color: #a78bfa; }
.dot-locked { background: #f1f5f9; color: #cbd5e1; }
/* 评级配色（与网页版 GRADE_STYLE 一致） */
.grade-S { background: #fbbf24; color: #78350f; }
.grade-A { background: #a78bfa; color: #fff; }
.grade-B { background: #38bdf8; color: #fff; }
.grade-C { background: #34d399; color: #fff; }
.grade-D { background: #cbd5e1; color: #475569; }
.grade-E { background: #e2e8f0; color: #64748b; }
.grade-F { background: #fecaca; color: #ef4444; }
.s-count { margin-left: auto; font-size: 11px; color: #94a3b8; }

.board { border-top: 1px solid #f1f5f9; padding: 12px 20px; }
.board-title { font-size: 12px; font-weight: 700; color: #94a3b8; margin-bottom: 6px; }
.board-empty { font-size: 12px; color: #cbd5e1; }
.board-row { display: flex; align-items: center; padding: 2px 0; font-size: 14px; }
.board-rank { width: 24px; font-weight: 900; color: #cbd5e1; }
.board-first { color: #f59e0b; }
.board-name { color: #475569; }
.board-score { margin-left: auto; font-weight: 700; color: #1e293b; }
